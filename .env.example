# Токен от @BotFather
BOT_TOKEN=

# Telegram ID админов через запятую (узнать свой: написать @userinfobot)
ADMIN_IDS=

# Публичный URL сервера (где доступно приложение). Должен быть HTTPS для Telegram.
# Локально — используй ngrok: BASE_URL=https://abc123.ngrok.io
BASE_URL=http://localhost:8000

# Часовой пояс
TZ=Europe/Moscow

# Порт (Render/Railway/Fly выставят сами)
PORT=8000

# Путь до файла БД
DB_PATH=data.db
